{
  "manifest_version": 3,
  "name": "IP Bakery",
  "version": "1.0",
  "description": "A tool for managing and querying IP addresses.",
  "action": {
    "default_icon": {
      "16": "Images/Furnace.png",
      "32": "Images/Furnace.png",
      "48": "Images/Furnace.png",
      "128": "Images/Furnace.png"
    },
    "default_title": "IP Bakery"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "clipboardWrite", "system.display", "tabs"],
  "host_permissions": [
    "https://*.tile.openstreetmap.org/*",
    "https://api.abuseipdb.com/*"
  ],
  "icons": {
    "16": "Images/Furnace.png",
    "32": "Images/Furnace.png",
    "48": "Images/Furnace.png",
    "128": "Images/Furnace.png"
  }
}
